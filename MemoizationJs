const memoize = (fn) => {
  const cache = new Map(); // Cache to store results
  return (...args) => {
    const key = JSON.stringify(args); // Use arguments as a key
    if (cache.has(key)) {
      console.log('Fetching from cache:', key);
      return cache.get(key);
    }
    console.log('Calculating result for:', key);
    const result = fn(...args); // Call the actual function
    cache.set(key, result); // Store the result in cache
    return result;
  };
};

// Example Usage
const add = (a, b) => a + b;

const memoizedAdd = memoize(add);

console.log(memoizedAdd(1, 2)); // Calculating result for: [1,2] => 3
console.log(memoizedAdd(1, 2)); // Fetching from cache: [1,2] => 3
console.log(memoizedAdd(2, 3)); // Calculating result for: [2,3] => 5
