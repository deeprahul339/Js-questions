const rightRotate=(arr,k)=>{
let length=arr.length;
k=k%length;
let newArr=[]
for(let i=0;i<length;i++)
{
    if(i<k)
    {
        newArr.push(arr[length+i-k])
    }
    else{
        newArr.push(arr[i-k])
    }
}
console.log(newArr)
}

const array = [1, 2, 3, 4, 5];
const K = 2;

rightRotate(array, K);
